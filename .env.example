# PostgreSQL connection string. Update database name, username and password.
DATABASE_URL=postgresql://postgres:Pero@localhost:5432/jobflow_db

# Generate a unique random value before deploying.
SECRET_KEY=replace-this-with-a-long-random-secret

# Email settings are required for account verification and password reset emails.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# Keep false for local default; only enable for local development debugging.
FLASK_DEBUG=false
